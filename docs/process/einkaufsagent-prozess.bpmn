<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_Einkaufsagent" targetNamespace="http://bpmn.io/schema/bpmn" exporter="gen_bpmn_v5.py" exporterVersion="5.0">
  <bpmn:collaboration id="Collaboration_Einkaufsagent">
    <bpmn:participant id="Participant_Musterhandel" name="Musterhandel AG (fiktiv): Konditionen-Nachverhandlung" processRef="Process_Einkaufsagent" />
    <bpmn:participant id="Participant_Lieferant" name="Lieferant (Eval: simuliert, Demo: Mensch in der Web-UI)" />
    <bpmn:messageFlow id="MsgFlow_Angebot" name="Angebot (2–3 Pakete)" sourceRef="Task_SendWait" targetRef="Participant_Lieferant" />
    <bpmn:messageFlow id="MsgFlow_Antwort" name="Antwort" sourceRef="Participant_Lieferant" targetRef="Task_SendWait" />
    <bpmn:messageFlow id="MsgFlow_Annahme" name="Annahme (Vorlage)" sourceRef="Task_Accept" targetRef="Participant_Lieferant" />
    <bpmn:messageFlow id="MsgFlow_Bestaetigung" name="Bestätigung oder Ablehnung" sourceRef="Participant_Lieferant" targetRef="Task_Accept" />
    <bpmn:messageFlow id="MsgFlow_Zwischenbescheid" name="Zwischenbescheid" sourceRef="Task_EskPrep" targetRef="Participant_Lieferant" />
    <bpmn:messageFlow id="MsgFlow_Ergebnis" name="Bestätigung oder Absage" sourceRef="Task_Notify" targetRef="Participant_Lieferant" />
  </bpmn:collaboration>
  <bpmn:error id="Error_LLM" name="LLM-Aufruf gescheitert" errorCode="llm_failed" />
  <bpmn:dataStore id="DataStore_ERP" name="ERP-Adapter (SQLite)" />
  <bpmn:dataStore id="DataStore_Policy" name="Einkaufsrichtlinie" />
  <bpmn:process id="Process_Einkaufsagent" name="Einkaufsagent" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Einkauf" name="Einkäuferin">
        <bpmn:flowNodeRef>Start_Beauftragt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Mandat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EskEntscheid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Freigabe</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Einkaufsagent (LangGraph)">
        <bpmn:flowNodeRef>Task_Kontext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_JoinLoop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pakete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Formulieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Formulieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Guard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Guard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_JoinTemplate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Template</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_JoinSend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_JoinExtract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Extract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Extract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Bewertung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_JoinEsc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EskPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Weiter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_JoinBuyer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_JoinFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Ergebnis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Abbruch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Deal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_KeinDeal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Beauftragt" name="Verhandlung beauftragt">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Mandat" name="Mandat festlegen">
      <bpmn:documentation>Einkäuferin erfasst das Mandat als strukturierte Daten (Ziele, Grenzen, erlaubte Zugeständnisse, max. Runden). LangGraph: Graph-Input, Pydantic-validiert.</bpmn:documentation>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Mandat">
        <bpmn:targetRef>DO_Mandat</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EskEntscheid" name="Eskalation entscheiden">
      <bpmn:documentation>LangGraph: ask_buyer, enthält nur interrupt(payload); beim Fortsetzen startet der Node von vorn. Der Runner (Web-UI oder Terminal) setzt mit Command(resume={decision, note}) und derselben thread_id fort. Entscheide: weiterverhandeln (Mandat bleibt, Bedingung bzw. Forderung wird zurückgewiesen und nicht erneut eskaliert); freigeben (nur angeboten, wenn escalate freigebbare Konditionen berechnet hat: Bedingung auf einer Grösse ausserhalb des Mandats, keine weitere Forderung oder Bedingung, Konditionen im Mandat und mindestens beim Mindestnutzen; der Code bucht diese Konditionen, die Bedingung steht als Vermerk im Protokoll, das Mandat bleibt) oder abbrechen. Die Notiz geht nur ins Protokoll. Die Eval setzt nicht fort und wertet den Halt als Eskalation (ADR 0015, Nachtrag 12.11.2026).</bpmn:documentation>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Freigabe" name="Entscheid der Einkäuferin?">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_21b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Kontext" name="Kontext laden">
      <bpmn:documentation>LangGraph: load_context. Stammdaten und heutige Konditionen über den ERP-Adapter (SQLite, ohne MCP; ADR 0009, 0015). Frühere Protokolle zeigt der Runner in der Demo an; der Graph nutzt sie nicht (Variante c gestrichen, ADR 0014).</bpmn:documentation>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:property id="Property_DIA_ERP" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_ERP">
        <bpmn:sourceRef>DS_ERP_Read</bpmn:sourceRef>
        <bpmn:targetRef>Property_DIA_ERP</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_JoinLoop">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Pakete" name="Pakete berechnen (Code)">
      <bpmn:documentation>LangGraph: offer_engine. 2–3 gleichwertige Pakete (MESO) entlang der Konzessionskurve; nur Werte im Mandat. Ausbau (c): Startpunkt aus der Paketwahl in früheren Protokollen.</bpmn:documentation>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Task_Formulieren" name="Angebot formulieren (LLM)">
      <bpmn:documentation>LangGraph: narrate. Formuliert die Pakete der offer_engine; sieht nur Pakete und Runde, nie das Mandat und nie den Lieferantentext. Scheitert der Aufruf nach den Retries, geht der Standardtext hinaus.</bpmn:documentation>
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_Formulieren" name="LLM-Fehler: kein Text" attachedToRef="Task_Formulieren">
      <bpmn:outgoing>Flow_E1</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_Boundary_Formulieren" errorRef="Error_LLM" />
    </bpmn:boundaryEvent>
    <bpmn:businessRuleTask id="Task_Guard" name="Nachricht prüfen (Code)">
      <bpmn:documentation>LangGraph: mandate_guard. Zahlen im Text = Paketwerte, jedes Paket genannt, kein Betrag, kein Walk-away-Leak, KI-Hinweis in der ersten Nachricht.</bpmn:documentation>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW_Guard" name="Mandat eingehalten?">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_JoinTemplate">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:incoming>Flow_E1</bpmn:incoming>
      <bpmn:outgoing>Flow_09b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Template" name="Standardtext verwenden (Code)">
      <bpmn:documentation>LangGraph: template_message. Fail-safe: Vorlage gibt die Pakete wörtlich wieder; Template-Rate ist Metrik.</bpmn:documentation>
      <bpmn:incoming>Flow_09b</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GW_JoinSend">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_SendWait" name="Angebot senden, Antwort abwarten">
      <bpmn:documentation>LangGraph: send_and_wait. Vor die Nachricht kommen Zurückweisungen aus Vorlagen. Eval: regelbasierter Simulator; Demo und Live-Runden: Mensch als Lieferant in der Web-UI (Terminal als Fallback), sieht nur den Text (ADR 0015, 0016).</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_JoinExtract">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_A2</bpmn:incoming>
      <bpmn:outgoing>Flow_12b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Extract" name="Antwort extrahieren (LLM)">
      <bpmn:documentation>LangGraph: parse_response. Strukturierte Ausgabe (Pydantic): Typ, gewähltes Paket, Gegenangebot, Aussagen mit Typ (Befugnis-Behauptung, Information, Forderung, Bedingung) und Grösse. Die Einkaufsrichtlinie steht vollständig im Prompt (ohne RAG; ADR 0009). Lieferantentext ist untrusted input. Scheitert die Extraktion auch nach der Korrekturrunde, gilt die Antwort als nicht auswertbar (im Code: assess_response eskaliert, ADR 0008 Regel 3).</bpmn:documentation>
      <bpmn:incoming>Flow_12b</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:property id="Property_DIA_Richtlinie_Extract" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Richtlinie_Extract">
        <bpmn:sourceRef>DS_Richtlinie</bpmn:sourceRef>
        <bpmn:targetRef>Property_DIA_Richtlinie_Extract</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_Extract" name="LLM-Fehler: nicht auswertbar" attachedToRef="Task_Extract">
      <bpmn:outgoing>Flow_E2</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_Boundary_Extract" errorRef="Error_LLM" />
    </bpmn:boundaryEvent>
    <bpmn:businessRuleTask id="Task_Assess" name="Antwort bewerten (Code)">
      <bpmn:documentation>LangGraph: assess_response. Einigung, wenn das gewählte Paket einem gesendeten entspricht oder unsere Annahme bestätigt wird. Ein Gegenangebot im Mandat, das mindestens so viel wert ist wie das eigene nächste Paket, wird angenommen (AC_next). Eskalation nur, wenn das Mandat den Entscheid nicht abdeckt: Bedingung, die das Mandat nicht regelt, abgelehnte Forderung wiederholt, Antwort nicht auswertbar (ADR 0008). Behauptungen über Zusagen ändern das Mandat nie: zurückweisen, protokollieren, weiter.</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW_Bewertung" name="Bewertung?">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_JoinEsc">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_E2</bpmn:incoming>
      <bpmn:outgoing>Flow_16b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_EskPrep" name="Eskalation aufbereiten (Code)">
      <bpmn:documentation>LangGraph: escalate. Vorlage für die Einkäuferin ohne LLM (ADR 0014): Grund nach ADR 0008, Zitat der Forderung, Verlauf und letzte Antwort. Schreibt das Protokoll mit Status «escalated» und sendet dem Lieferanten einen Zwischenbescheid. Berechnet ohne LLM, welche Konditionen die Einkäuferin freigeben könnte (oder keine). Nichts davon steht in ask_buyer, weil dieser Node beim Fortsetzen neu startet.</bpmn:documentation>
      <bpmn:incoming>Flow_16b</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GW_Weiter" name="Nächster Schritt?">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:outgoing>Flow_A1</bpmn:outgoing>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Accept" name="Annahme senden, Bestätigung abwarten">
      <bpmn:documentation>LangGraph: send_and_wait mit pending.kind = accept; Text aus der Vorlage accept_text (kein LLM). Die Antwort wird extrahiert und bewertet wie jede andere. «accept» gilt nur für das letzte Gegenangebot; eine abgelehnte Annahme zählt als Runde. Ein Gegenangebot ist auch nach der letzten Runde annehmbar.</bpmn:documentation>
      <bpmn:incoming>Flow_A1</bpmn:incoming>
      <bpmn:outgoing>Flow_A2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_JoinBuyer">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:incoming>Flow_21b</bpmn:incoming>
      <bpmn:outgoing>Flow_21c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_JoinFinal">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_21c</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Record" name="Ergebnis und Protokoll erfassen">
      <bpmn:documentation>LangGraph: record_outcome über den ERP-Adapter, auf allen Ausgängen, idempotent pro Verhandlung: Konditionen bei Deal gebucht (auch nach Freigabe durch die Einkäuferin); Protokoll mit Startpaketen, Reaktion und Paketwahl pro Runde, Ergebnis, Hinweisen sowie Entscheid und Notiz der Einkäuferin. Langzeitgedächtnis (ADR 0015); Metrik korrekt_gebucht.</bpmn:documentation>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_ERP">
        <bpmn:targetRef>DS_ERP_Write</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_Notify" name="Ergebnis mitteilen">
      <bpmn:documentation>LangGraph: notify_supplier. Vorlage: Bestätigung (nach einer Freigabe mit Verweis auf die Rücksprache mit der Einkäuferin), Absage oder Abbruch nach Rücksprache mit der Einkäuferin.</bpmn:documentation>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="GW_Ergebnis" name="Ergebnis?">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Abbruch" name="Nach Eskalation abgebrochen">
      <bpmn:incoming>Flow_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Deal" name="Neue Konditionen vereinbart">
      <bpmn:incoming>Flow_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_KeinDeal" name="Kein Deal">
      <bpmn:incoming>Flow_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="DataObject_Mandat" />
    <bpmn:dataObjectReference id="DO_Mandat" name="Mandat" dataObjectRef="DataObject_Mandat" />
    <bpmn:dataStoreReference id="DS_ERP_Read" name="ERP-Adapter (SQLite): Stammdaten, Konditionen, Protokolle" dataStoreRef="DataStore_ERP" />
    <bpmn:dataStoreReference id="DS_ERP_Write" name="ERP-Adapter (SQLite): Stammdaten, Konditionen, Protokolle" dataStoreRef="DataStore_ERP" />
    <bpmn:dataStoreReference id="DS_Richtlinie" name="Einkaufsrichtlinie (im Prompt)" dataStoreRef="DataStore_Policy" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Beauftragt" targetRef="Task_Mandat" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Mandat" targetRef="Task_Kontext" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_Kontext" targetRef="GW_JoinLoop" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="GW_JoinLoop" targetRef="Task_Pakete" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_Pakete" targetRef="Task_Formulieren" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_Formulieren" targetRef="Task_Guard" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_Guard" targetRef="GW_Guard" />
    <bpmn:sequenceFlow id="Flow_08" name="ja" sourceRef="GW_Guard" targetRef="GW_JoinSend">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.guard_ok</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09" name="nein" sourceRef="GW_Guard" targetRef="GW_JoinTemplate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not state.guard_ok</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_E1" sourceRef="Boundary_Formulieren" targetRef="GW_JoinTemplate" />
    <bpmn:sequenceFlow id="Flow_09b" sourceRef="GW_JoinTemplate" targetRef="Task_Template" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Template" targetRef="GW_JoinSend" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="GW_JoinSend" targetRef="Task_SendWait" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_SendWait" targetRef="GW_JoinExtract" />
    <bpmn:sequenceFlow id="Flow_12b" sourceRef="GW_JoinExtract" targetRef="Task_Extract" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Extract" targetRef="Task_Assess" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Assess" targetRef="GW_Bewertung" />
    <bpmn:sequenceFlow id="Flow_15" name="Einigung" sourceRef="GW_Bewertung" targetRef="GW_JoinFinal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.assessment == &quot;deal&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" name="Mandat reicht nicht oder unklar" sourceRef="GW_Bewertung" targetRef="GW_JoinEsc">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.assessment == &quot;escalate&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_E2" sourceRef="Boundary_Extract" targetRef="GW_JoinEsc" />
    <bpmn:sequenceFlow id="Flow_16b" sourceRef="GW_JoinEsc" targetRef="Task_EskPrep" />
    <bpmn:sequenceFlow id="Flow_17" name="Gegenangebot oder Ablehnung" sourceRef="GW_Bewertung" targetRef="GW_Weiter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.assessment in (&quot;counter&quot;, &quot;reject&quot;)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_EskPrep" targetRef="Task_EskEntscheid" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_EskEntscheid" targetRef="GW_Freigabe" />
    <bpmn:sequenceFlow id="Flow_20" name="weiterverhandeln (Mandat bleibt)" sourceRef="GW_Freigabe" targetRef="GW_JoinLoop">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.buyer_decision == &quot;weiterverhandeln&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_21" name="abbrechen" sourceRef="GW_Freigabe" targetRef="GW_JoinBuyer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.buyer_decision == &quot;abbrechen&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_21b" name="freigeben (Bedingung annehmen)" sourceRef="GW_Freigabe" targetRef="GW_JoinBuyer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.buyer_decision == &quot;freigeben&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_21c" sourceRef="GW_JoinBuyer" targetRef="GW_JoinFinal" />
    <bpmn:sequenceFlow id="Flow_22" name="neue Runde: Runde &lt; max. Runden, Paket offen, keine endgültige Absage" sourceRef="GW_Weiter" targetRef="GW_JoinLoop">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.round &lt; state.mandate.max_rounds and state.packages_left &gt; 0 and not state.supplier_final</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A1" name="Gegenangebot annehmbar (AC_next)" sourceRef="GW_Weiter" targetRef="Task_Accept">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.assessment == &quot;accept_counter&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Task_Accept" targetRef="GW_JoinExtract" />
    <bpmn:sequenceFlow id="Flow_23" name="sonst: kein Deal" sourceRef="GW_Weiter" targetRef="GW_JoinFinal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.assessment != &quot;accept_counter&quot; and not (state.round &lt; state.mandate.max_rounds and state.packages_left &gt; 0 and not state.supplier_final)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="GW_JoinFinal" targetRef="Task_Record" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_Record" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_Notify" targetRef="GW_Ergebnis" />
    <bpmn:sequenceFlow id="Flow_27" name="Deal" sourceRef="GW_Ergebnis" targetRef="End_Deal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.outcome == &quot;deal&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_28" name="abgebrochen" sourceRef="GW_Ergebnis" targetRef="End_Abbruch">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.outcome == &quot;escalated&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_29" name="kein Deal" sourceRef="GW_Ergebnis" targetRef="End_KeinDeal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.outcome == &quot;no_deal&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:textAnnotation id="Annotation_Legende"><bpmn:text>Farben: orange = LLM (probabilistisch) · blau = Code (deterministisch) · grün = Mensch.
Grundsatz: LLM extrahiert und formuliert, Code entscheidet über Zahlen und Mandat.
Ablation: (a) ein LLM-Node übernimmt Pakete, Formulieren, Extrahieren und Bewerten, ohne Prüfung im Code; (b) wie gezeichnet.
Gedächtnis: State pro Verhandlung im Checkpointer, Protokolle im ERP-Adapter (ADR 0015); (c) wäre der Ausbau.
ERP-Adapter ohne MCP, Richtlinie ohne RAG (ADR 0009). Eine Instanz pro Lieferant.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_Assess"><bpmn:text>Zurückweisungen (Behauptung, Forderung, Entscheid der Einkäuferin) als Vorlagensatz vor der nächsten Nachricht. Konfidenz &lt; 0,7 = unklar → Eskalation (Haken, ADR 0011).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Annotation_Assess" sourceRef="Task_Assess" targetRef="Annotation_Assess" />
  </bpmn:process>
