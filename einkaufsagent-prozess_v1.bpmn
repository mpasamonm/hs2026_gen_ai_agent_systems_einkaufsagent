<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_Einkaufsagent" targetNamespace="http://bpmn.io/schema/bpmn" exporter="gen_bpmn.py" exporterVersion="2.0">
  <bpmn:collaboration id="Collaboration_Einkaufsagent">
    <bpmn:participant id="Participant_Musterhandel" name="Musterhandel AG (fiktiv): Konditionen-Nachverhandlung" processRef="Process_Einkaufsagent" />
    <bpmn:participant id="Participant_Lieferant" name="Lieferant (im Projekt simuliert)" />
    <bpmn:messageFlow id="MsgFlow_Angebot" name="Angebot (2–3 Pakete)" sourceRef="Task_Send" targetRef="Participant_Lieferant" />
    <bpmn:messageFlow id="MsgFlow_Antwort" name="Antwort" sourceRef="Participant_Lieferant" targetRef="Task_Receive" />
    <bpmn:messageFlow id="MsgFlow_Ergebnis" name="Bestätigung oder Absage" sourceRef="Task_Notify" targetRef="Participant_Lieferant" />
  </bpmn:collaboration>
  <bpmn:dataStore id="DataStore_ERP" name="ERP" />
  <bpmn:dataStore id="DataStore_Memory" name="Lieferanten-Gedächtnis" />
  <bpmn:process id="Process_Einkaufsagent" name="Einkaufsagent" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Einkauf" name="Einkäuferin">
        <bpmn:flowNodeRef>Start_Beauftragt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Mandat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EskEntscheid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Esk</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Einkaufsagent (LangGraph)">
        <bpmn:flowNodeRef>Task_Kontext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Strategie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_JoinPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pakete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Formulieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Guard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Guard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Template</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_JoinSend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Antwort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Extract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Art</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_JoinEsk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Summary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Weiter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Book</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_JoinFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Memory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Ergebnis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Deal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Uebergabe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_KeinDeal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Beauftragt" name="Nachverhandlung beauftragt">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Mandat" name="Mandat festlegen">
      <bpmn:documentation>Einkäuferin erfasst das Mandat als strukturierte Daten (Ziele, Grenzen, erlaubte Zugeständnisse, max. Runden). LangGraph: Graph-Input, Pydantic-validiert.</bpmn:documentation>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Mandat">
        <bpmn:targetRef>DO_Mandat</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EskEntscheid" name="Eskalation entscheiden">
      <bpmn:documentation>LangGraph: interrupt() im Node escalate; Resume per Command(resume={decision, new_mandate?}). MVP: KW46.</bpmn:documentation>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Esk" name="Freigabe zum Weiterverhandeln?">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Kontext" name="Kontext laden (ERP via MCP)">
      <bpmn:documentation>LangGraph: load_context. KW42: JSON-Stub; KW43: ERP-Mock als MCP-Server (SQLite).</bpmn:documentation>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:property id="Property_DIA_ERP" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_ERP">
        <bpmn:sourceRef>DS_ERP</bpmn:sourceRef>
        <bpmn:targetRef>Property_DIA_ERP</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Strategie" name="Strategie wählen (LLM)">
      <bpmn:documentation>LangGraph: plan. LLM wählt Konzessionstaktik (Boulware/Conceder) aus Lieferantenprofil und Gedächtnis. MVP: KW43 (Variante b).</bpmn:documentation>
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:property id="Property_DIA_Mem" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Mem">
        <bpmn:sourceRef>DS_Mem_Read</bpmn:sourceRef>
        <bpmn:targetRef>Property_DIA_Mem</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_JoinPlan">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Pakete" name="Pakete berechnen (Code)">
      <bpmn:documentation>LangGraph: offer_engine. 2–3 gleichwertige Pakete (MESO) entlang der Konzessionskurve; nur Werte innerhalb des Mandats. MVP: KW43.</bpmn:documentation>
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Task_Formulieren" name="Angebot formulieren (LLM)">
      <bpmn:documentation>LangGraph: narrate. Zahlen kommen ausschliesslich aus offer_engine.</bpmn:documentation>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_Guard" name="Nachricht prüfen (Code)">
      <bpmn:documentation>LangGraph: mandate_guard. Prüft: Zahlen im Text = Paketwerte, keine Zusagen ausserhalb Mandat, kein Walk-away-Leak, KI-Hinweis, keine erfundenen Fakten (Regelliste).</bpmn:documentation>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW_Guard" name="Mandat eingehalten?">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Template" name="Standardtext verwenden (Code)">
      <bpmn:documentation>LangGraph: template_message. Fail-safe: deterministische Vorlage rendert die Pakete wörtlich; zählt als Template-Rate in der Evaluation.</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GW_JoinSend">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Send" name="Angebot senden">
      <bpmn:documentation>LangGraph: send_and_wait (Teil 1). Im Projekt: simulierter Lieferant; real: Kanal + interrupt().</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_Receive" name="Antwort empfangen">
      <bpmn:documentation>LangGraph: send_and_wait (Teil 2).</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Timer_Antwort" name="48 h ohne Antwort" attachedToRef="Task_Receive">
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Antwort">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_Extract" name="Antwort extrahieren (LLM)">
      <bpmn:documentation>LangGraph: parse_response. Strukturierte Ausgabe (Pydantic): Typ, gewähltes Paket, Gegenangebot, neue Forderungen, Konfidenz. Lieferantentext ist untrusted input.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_Assess" name="Antwort bewerten (Code)">
      <bpmn:documentation>LangGraph: assess_response. Deterministisch: Annahme nur, wenn Paket-ID zu einem gesendeten Paket passt; Gegenangebot annehmen, wenn im Mandat und Nutzen ≥ nächstes eigenes Paket (AC_next); neue Dimension, Preiserhöhung über Mandat oder Konfidenz &lt; Schwelle → Eskalation.</bpmn:documentation>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW_Art" name="Bewertung?">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_JoinEsk">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Summary" name="Eskalation aufbereiten (LLM)">
      <bpmn:documentation>LangGraph: escalate (vor interrupt). Zusammenfassung: Forderung, Gegenwert, Empfehlung (US4).</bpmn:documentation>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Weiter" name="Weiterverhandeln?">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Book" name="Konditionen im ERP erfassen (MCP)">
      <bpmn:documentation>LangGraph: book_deal. MVP: KW43 (ERP-Mock).</bpmn:documentation>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_JoinFinal">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Notify" name="Ergebnis mitteilen">
      <bpmn:documentation>LangGraph: notify_supplier. Bestätigung, Absage oder Hinweis auf Übernahme durch die Einkäuferin; Lieferant bleibt nie ohne Abschlussnachricht.</bpmn:documentation>
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_Memory" name="Protokoll und Gedächtnis aktualisieren">
      <bpmn:documentation>LangGraph: update_memory (Store). Auf allen Ausgängen, auch ohne Deal (US6). MVP: KW46.</bpmn:documentation>
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Mem">
        <bpmn:targetRef>DS_Mem_Write</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Ergebnis" name="Ergebnis?">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Deal" name="Neue Konditionen vereinbart">
      <bpmn:incoming>Flow_32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Uebergabe" name="An Einkäuferin übergeben">
      <bpmn:incoming>Flow_33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_KeinDeal" name="Kein Deal">
      <bpmn:incoming>Flow_34</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="DataObject_Mandat" />
    <bpmn:dataObjectReference id="DO_Mandat" name="Mandat" dataObjectRef="DataObject_Mandat" />
    <bpmn:dataStoreReference id="DS_ERP" name="ERP-Mock" dataStoreRef="DataStore_ERP" />
    <bpmn:dataStoreReference id="DS_Mem_Read" name="Lieferanten-Gedächtnis" dataStoreRef="DataStore_Memory" />
    <bpmn:dataStoreReference id="DS_Mem_Write" name="Lieferanten-Gedächtnis" dataStoreRef="DataStore_Memory" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Beauftragt" targetRef="Task_Mandat" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Mandat" targetRef="Task_Kontext" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_Kontext" targetRef="Task_Strategie" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_Strategie" targetRef="GW_JoinPlan" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="GW_JoinPlan" targetRef="Task_Pakete" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_Pakete" targetRef="Task_Formulieren" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_Formulieren" targetRef="Task_Guard" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_Guard" targetRef="GW_Guard" />
    <bpmn:sequenceFlow id="Flow_09" name="ja" sourceRef="GW_Guard" targetRef="GW_JoinSend">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.guard_ok</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" name="nein" sourceRef="GW_Guard" targetRef="Task_Template">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not state.guard_ok</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Template" targetRef="GW_JoinSend" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="GW_JoinSend" targetRef="Task_Send" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Send" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Receive" targetRef="Task_Extract" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Extract" targetRef="Task_Assess" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_Assess" targetRef="GW_Art" />
    <bpmn:sequenceFlow id="Flow_17" name="Einigung" sourceRef="GW_Art" targetRef="Task_Book">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.assessment == &quot;agreement&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18" name="ausserhalb Mandat oder unklar" sourceRef="GW_Art" targetRef="GW_JoinEsk">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.assessment == &quot;escalate&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19" name="Gegenangebot ungenügend oder Ablehnung" sourceRef="GW_Art" targetRef="GW_Weiter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.assessment in (&quot;counter&quot;, &quot;reject&quot;)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Timer_Antwort" targetRef="GW_JoinEsk" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="GW_JoinEsk" targetRef="Task_Summary" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_Summary" targetRef="Task_EskEntscheid" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_EskEntscheid" targetRef="GW_Esk" />
    <bpmn:sequenceFlow id="Flow_24" name="ja (ggf. Mandat erweitert)" sourceRef="GW_Esk" targetRef="GW_JoinPlan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.escalation_decision == &quot;continue&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_25" name="nein: abbrechen oder übernehmen" sourceRef="GW_Esk" targetRef="GW_JoinFinal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.escalation_decision in (&quot;abort&quot;, &quot;takeover&quot;)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_26" name="ja: Runde &lt; max. Runden, Paket offen, Lieferant verhandelt weiter" sourceRef="GW_Weiter" targetRef="GW_JoinPlan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.round &lt; state.mandate.max_rounds and state.packages_left &gt; 0 and not state.supplier_final</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_27" name="nein" sourceRef="GW_Weiter" targetRef="GW_JoinFinal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not (state.round &lt; state.mandate.max_rounds and state.packages_left &gt; 0 and not state.supplier_final)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_Book" targetRef="GW_JoinFinal" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="GW_JoinFinal" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_Notify" targetRef="Task_Memory" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_Memory" targetRef="GW_Ergebnis" />
    <bpmn:sequenceFlow id="Flow_32" name="Deal" sourceRef="GW_Ergebnis" targetRef="End_Deal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.outcome == &quot;deal&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_33" name="übergeben" sourceRef="GW_Ergebnis" targetRef="End_Uebergabe">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.outcome == &quot;handed_over&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_34" name="kein Deal" sourceRef="GW_Ergebnis" targetRef="End_KeinDeal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">state.outcome == &quot;no_deal&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:textAnnotation id="Annotation_Legende"><bpmn:text>Farben: orange = LLM (probabilistisch) · blau = Code (deterministisch) · grün = Mensch.
Grundsatz: LLM schlägt vor und formuliert, Code entscheidet über Zahlen und Mandat.
LangGraph-Node-Namen stehen in der Dokumentation jedes Elements.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Einkaufsagent">
      <bpmndi:BPMNShape id="Participant_Musterhandel_di" bpmnElement="Participant_Musterhandel" isHorizontal="true"><dc:Bounds x="150" y="60" width="2910" height="740" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Einkauf_di" bpmnElement="Lane_Einkauf" isHorizontal="true"><dc:Bounds x="180" y="60" width="2880" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Agent_di" bpmnElement="Lane_Agent" isHorizontal="true"><dc:Bounds x="180" y="260" width="2880" height="540" /></bpmndi:BPMNShape>
