# Kopieren nach .env (nie committen). Werte aus der Moodle-Demo bzw. dem LiteLLM-Login übernehmen.
LITELLM_BASE_URL=https://<litellm-host-der-fhnw>
LITELLM_API_KEY=sk-...

# LangSmith-Tracing (KW42-Deliverable)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=einkaufsagent
# Nur bei einem LangSmith-Account in der EU-Region:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
